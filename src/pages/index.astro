---
import Layout from "../layouts/Layout.astro";
import BlogList from "../components/BlogList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getAllPosts } from "../lib/sanity";
import { projects } from "../data/projects";
import type { Post } from "../types/sanity";

const posts: Post[] = await getAllPosts();
const recentPosts = posts.slice(0, 3);
const featuredProjects = projects.filter((p) => p.featured);
---

<Layout
  title="張允庭 — Flutter Developer"
  description="熱愛滑雪與程式設計的開發者，分享技術文章與作品"
>
  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="container hero-content">
      <div class="hero-text">
        <p class="hero-eyebrow">Hi, I'm</p>
        <h1 class="hero-name">張允庭</h1>
        <p class="hero-title">Flutter Developer</p>
        <p class="hero-desc">
          熱愛在雪山上滑行，也喜歡在程式碼裡探索。
          <br />分享開發心得、滑雪紀錄和各種生活思考。
        </p>
        <div class="hero-actions">
          <a href="/projects" class="btn btn-primary">查看作品集</a>
          <a href="/about" class="btn btn-outline">關於我</a>
        </div>
      </div>
    </div>

    <!-- 裝飾：雪山輪廓 -->
    <div class="hero-mountains" aria-hidden="true">
      <svg viewBox="0 0 1440 200" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M0,200 L0,140 L120,60 L200,100 L320,20 L440,90 L560,40 L680,110 L800,50 L920,120 L1040,30 L1160,100 L1280,55 L1440,130 L1440,200 Z"
          fill="rgba(255,255,255,0.04)"
        />
        <path
          d="M0,200 L0,160 L180,90 L300,130 L420,70 L560,120 L700,65 L840,130 L960,75 L1100,140 L1220,80 L1340,130 L1440,100 L1440,200 Z"
          fill="rgba(255,255,255,0.03)"
        />
      </svg>
    </div>
  </section>

  <!-- ===== 精選作品 ===== -->
  {featuredProjects.length > 0 && (
    <section class="section featured-projects">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">精選作品</h2>
          <a href="/projects" class="view-all-link">查看所有作品 →</a>
        </div>
        <div class="projects-grid">
          {featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== 最新文章 ===== -->
  <section class="section recent-posts">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">最新文章</h2>
        <a href="/blog" class="view-all-link">查看所有文章 →</a>
      </div>

      {recentPosts.length > 0 ? (
        <BlogList posts={recentPosts} />
      ) : (
        <div class="empty-state">
          <p>文章即將登場，敬請期待！</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  /* ===== Hero ===== */
  .hero {
    position: relative;
    background: linear-gradient(
      160deg,
      var(--color-hero-from) 0%,
      var(--color-hero-mid) 55%,
      var(--color-hero-to) 100%
    );
    padding: 7rem 0 5rem;
    overflow: hidden;
    margin-top: -1px;
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-text {
    max-width: 640px;
  }

  .hero-eyebrow {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-secondary);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .hero-name {
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 800;
    color: white;
    line-height: 1.1;
    margin-bottom: var(--space-2);
    letter-spacing: -0.02em;
  }

  .hero-title {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
    font-family: var(--font-heading);
  }

  .hero-desc {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.8;
    margin-bottom: var(--space-8);
    max-width: 500px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .hero-mountains {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 200px;
    pointer-events: none;
  }

  .hero-mountains svg {
    width: 100%;
    height: 100%;
  }

  /* ===== 精選作品 ===== */
  .featured-projects {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  /* ===== 最新文章 ===== */
  .recent-posts {
    padding: var(--space-16) 0;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .section-title {
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    margin-bottom: 0;
  }

  .view-all-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--transition);
  }

  .view-all-link:hover {
    opacity: 0.75;
    color: var(--color-accent);
    text-decoration: none;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-16) 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 5rem 0 4rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
