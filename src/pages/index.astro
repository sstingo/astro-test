---
import Layout from '../layouts/Layout.astro';
import BlogList from '../components/BlogList.astro';
import { getAllPosts } from '../lib/sanity';
import type { Post } from '../types/sanity';

const posts: Post[] = await getAllPosts();
const recentPosts = posts.slice(0, 6);
---

<Layout
  title="首頁"
  description="歡迎來到我的 blog，分享技術、生活和思考"
>
  <section class="hero">
    <h1>歡迎來到 Astro Blog</h1>
    <p>一個使用 Astro 和 Sanity 構建的現代化 blog</p>
  </section>

  <section class="recent-posts">
    <h2>最新文章</h2>
    {recentPosts.length > 0 ? (
      <>
        <BlogList posts={recentPosts} />
        <div class="view-all">
          <a href="/blog" class="button">查看所有文章</a>
        </div>
      </>
    ) : (
      <p class="no-posts">暫無文章，請在 Sanity 中創建文章。</p>
    )}
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 4rem 0;
    border-bottom: 1px solid #e2e8f0;
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  .hero p {
    font-size: 1.25rem;
    color: var(--color-secondary);
  }

  .recent-posts h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .view-all {
    text-align: center;
    margin-top: 2rem;
  }

  .button {
    display: inline-block;
    background-color: var(--color-primary);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 0.375rem;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .button:hover {
    background-color: #2c5aa0;
    text-decoration: none;
  }

  .no-posts {
    text-align: center;
    color: var(--color-secondary);
    padding: 3rem 0;
    font-size: 1.125rem;
  }
</style>
