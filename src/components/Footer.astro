---
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container">
    <p>&copy; {currentYear} Astro Blog. Built with Astro and Sanity.</p>
  </div>
</footer>

<style>
  footer {
    background-color: #f7fafc;
    padding: 2rem 0;
    margin-top: 4rem;
    border-top: 1px solid #e2e8f0;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1rem;
    text-align: center;
    color: var(--color-secondary);
  }
</style>
