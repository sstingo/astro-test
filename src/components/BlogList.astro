---
import BlogCard from './BlogCard.astro';
import type { Post } from '../types/sanity';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<div class="blog-list">
  {posts.map((post) => (
    <BlogCard post={post} />
  ))}
</div>

<style>
  .blog-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-6);
  }
</style>
