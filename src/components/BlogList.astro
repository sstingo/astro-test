---
import BlogCard from './BlogCard.astro';
import type { Post } from '../types/sanity';

interface Props {
  posts: Post[];
  reveal?: boolean;
}

const { posts, reveal = false } = Astro.props;
---

<div class="blog-list">
  {posts.map((post, i) => (
    <div class={reveal ? 'reveal' : undefined} style={reveal ? `transition-delay: ${i * 0.1}s` : undefined}>
      <BlogCard post={post} />
    </div>
  ))}
</div>

<style>
  .blog-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-6);
  }
</style>
